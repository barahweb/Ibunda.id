# Salin file ini ke ".env.docker" di root project, lalu isi APP_KEY (jalanin
# `docker compose run --rm app php artisan key:generate --show`, tempel hasilnya di
# bawah). File .env.docker ini terpisah dari .env biasa (dipakai buat development
# lokal/Herd), khusus buat docker-compose.

APP_NAME="Quiz Assessment"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ibunda_id
DB_USERNAME=ibunda_id
DB_PASSWORD=secret

# Dipakai container mysql buat bikin database & user di atas otomatis.
MYSQL_ROOT_PASSWORD=secret

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# Opsional, kalau mau pasang captcha di halaman daftar (lihat README).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
