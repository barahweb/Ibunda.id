# Salin file ini ke ".env.docker" di root project, lalu isi APP_KEY (jalanin
# `docker compose run --rm app php artisan key:generate --show`, tempel hasilnya di
# bawah). File .env.docker ini terpisah dari .env biasa (dipakai buat development
# lokal/Herd), khusus buat docker-compose.

APP_NAME="Quiz Assessment"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ibunda_id
DB_USERNAME=ibunda_id
DB_PASSWORD=secret

# Dipakai container mysql buat bikin database & user otomatis. Nilainya HARUS sama
# dengan DB_DATABASE, DB_USERNAME, DB_PASSWORD di atas. Ganti "secret" jadi password kuat.
MYSQL_DATABASE=ibunda_id
MYSQL_USER=ibunda_id
MYSQL_PASSWORD=secret
MYSQL_ROOT_PASSWORD=secret

# Percaya header proxy HTTPS (Caddy/Nginx/Cloudflare di depan container ini).
TRUSTED_PROXIES=*

# Isi true cuma kalau mau seed data demo (akun contoh berpassword "password") di server ini.
SEED_DEMO_DATA=false

# Email (lupa password dll). "log" = email cuma ditulis ke log, gak terkirim beneran.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="Quiz Assessment"

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# Opsional, kalau mau pasang captcha di halaman daftar (lihat README).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Opsional: aktifkan tombol Interpretasi AI di halaman hasil Tes Kepribadian
# AI_PROVIDER: gemini (tier gratis) atau anthropic (berbayar)
AI_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
